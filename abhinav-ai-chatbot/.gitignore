__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
*.log
*.sqlite
*.sqlite3

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# --- Build Outputs ---
frontend/admin-dashboard/dist/
frontend/admin-dashboard/build/
