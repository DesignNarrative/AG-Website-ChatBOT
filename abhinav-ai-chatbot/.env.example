# ============================================================
# Abhinav Group AI Chatbot — Environment Variables Template
# NEVER commit the real .env file to version control.
# Copy this file to .env and fill in real values.
# ============================================================

# --- Application ---
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://abhinavgroup.co.in

# --- Database ---
# For LOCAL DEVELOPMENT use SQLite (leave DATABASE_URL as sqlite)
DATABASE_URL=sqlite:///./abhinav_chatbot_dev.db
# For STAGING / PRODUCTION use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://username:password@host:5432/abhinav_chatbot

# --- Vector Store ---
# Options: sqlite_vss | faiss | pgvector
# Use faiss for local dev, pgvector for staging/production
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store
# PGVECTOR_CONNECTION_STRING=postgresql+psycopg2://username:password@host:5432/abhinav_chatbot

# --- AI Provider (configure ONE primary provider) ---
# Options: gemini | openai | mock
AI_PROVIDER=mock           # Set to 'mock' until real API key is provided

# Google Gemini (Recommended — best Hindi+English support)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (Alternative — for benchmarking)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI Settings ---
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1          # Low temperature for factual accuracy
AI_TIMEOUT_SECONDS=30

# --- RAG Settings ---
RAG_TOP_K=5                 # Number of knowledge chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_TOKENS=4096
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Lead Management ---
LEAD_DEDUP_WINDOW_HOURS=24  # Same phone+project within 24h = duplicate
LEAD_NOTIFICATION_EMAIL=sales@abhinavinfra.com
LEAD_NOTIFICATION_ENABLED=false   # Enable when email is configured

# --- Email (for lead notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_EMAIL
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
EMAIL_FROM=noreply@abhinavgroup.co.in

# --- Mdoc CRM Integration ---
MDOC_ENABLED=false                 # Keep false until real credentials received
MDOC_MODE=mock                     # mock | sandbox | production
MDOC_API_BASE_URL=https://api.mymdoc.io   # Update with actual endpoint
MDOC_API_KEY=YOUR_MDOC_API_KEY
MDOC_TIMEOUT_SECONDS=10
MDOC_RETRY_ATTEMPTS=3
MDOC_RETRY_DELAY_SECONDS=5

# --- Background Tasks (Celery + Redis) ---
CELERY_ENABLED=false               # Set true when Redis is available
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- WordPress Plugin ---
# The API key the WordPress plugin sends in the X-Widget-API-Key header
WIDGET_API_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHARACTER_HEX_STRING
WIDGET_ALLOWED_DOMAINS=abhinavgroup.co.in,www.abhinavgroup.co.in,localhost

# --- Rate Limiting ---
RATE_LIMIT_CHAT=30/minute          # Per IP, chat endpoint
RATE_LIMIT_LEAD=10/minute          # Per IP, lead creation
RATE_LIMIT_ADMIN=100/minute        # Admin API

# --- Monitoring ---
SENTRY_DSN=                        # Optional: paste Sentry DSN for error tracking
HEALTH_CHECK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,jpg,jpeg,png

# --- Scraping / Crawling ---
CRAWL_USER_AGENT=AbhinavChatbot/1.0 (property-info-bot; contact@abhinavgroup.co.in)
CRAWL_REQUEST_DELAY_SECONDS=2      # Polite crawl delay
CRAWL_MAX_PAGES=200
CRAWL_TIMEOUT_SECONDS=30
