# =============================================================================
# Abhinav Group AI Property Chatbot — Admin Dashboard & Widget Static Server
# Builds React Admin Panel + serves static widget via Nginx
# =============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY frontend/admin-dashboard/package.json frontend/admin-dashboard/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/admin-dashboard ./
RUN pnpm run build

# --- Runtime Nginx Stage ---
FROM nginx:alpine AS runner

# Remove default nginx index
RUN rm -rf /usr/share/nginx/html/*

# Copy built React admin dashboard
COPY --from=builder /app/dist /usr/share/nginx/html/admin

# Copy minified widget file to static directory
COPY frontend/chatbot-widget/dist/abhinav-chatbot.min.js /usr/share/nginx/html/static/abhinav-chatbot.min.js

# Custom nginx configuration
COPY deployment/nginx-app.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
